# Copy to .env for local dev. On Railway, set these as service variables.

# Public URL of the site (no trailing slash). Used in emails and the origin check.
PUBLIC_URL=http://localhost:3000
# Optional: redirect every other hostname to this one (production: klinik.richworks.com).
CANONICAL_HOST=

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-REF.supabase.co
SUPABASE_ANON_KEY=
# Secret. Server only. Never put this in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic console → API keys. Set a monthly spend limit on the key's workspace.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Sonnet 5.5 defaults to high when unset; medium keeps cost and latency down.
CLAUDE_EFFORT=medium

# Optional daily caps (rolling 24 hours). Empty or 0 = no limit; then the Anthropic
# console spend limit is the only cost guard, so set one.
DAILY_AI_LIMIT_PER_USER=
DAILY_AI_LIMIT_GLOBAL=

# Resend → API keys. Day 7 reminders are skipped when unset.
RESEND_API_KEY=
EMAIL_FROM="Klinik Bisnes SME <noreply@richworks.com>"

# Bump when the privacy notice changes; participants are asked to accept again.
NOTICE_VERSION=2026-10-v2
