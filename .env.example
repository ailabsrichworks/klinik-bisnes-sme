# Copy to .env for local dev. On Railway, set these as service variables.

# Public URL of the site (no trailing slash). Used in the origin check.
PUBLIC_URL=http://localhost:3000
# Optional: redirect every other hostname to this one (production: klinik.richworks.com).
CANONICAL_HOST=

# Option A (simplest): the Apps Script pasted into the Google Sheet. See README → Setup.
# The Web app URL (ends in /exec), and the secret that matches SECRET in Code.gs.
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=

# Option B: Google service account key: paste the whole JSON key file on one line, or base64 of it.
# Secret. Never commit it. With neither option set, the app runs on an in-memory
# sheet (fine for trying it out; everything is lost on restart).
GOOGLE_SERVICE_ACCOUNT_JSON=
# The long code in the Sheet's URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=
# Folder INSIDE A SHARED DRIVE (not My Drive): drive.google.com/drive/folders/<DRIVE_FOLDER_ID>
DRIVE_FOLDER_ID=

# Anthropic console → API keys (the AI coach). Set a monthly spend limit on the key's workspace.
# Without a key the report uses the fixed v4 text instead.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Sonnet 5.5 defaults to high when unset; medium keeps cost and latency down.
CLAUDE_EFFORT=medium

# Optional daily AI caps (rolling 24 hours). Empty or 0 = no limit; then the Anthropic
# console spend limit is the only cost guard, so set one.
DAILY_AI_LIMIT_PER_USER=
DAILY_AI_LIMIT_PER_IP=
DAILY_AI_LIMIT_GLOBAL=

# Bump when the privacy notice changes; participants are asked to accept again.
NOTICE_VERSION=2026-10-v6
# The class page the report button opens after the PDF downloads.
CLASS_URL=https://klinikbisnessme.rcg.my
