# Copy to .env for local dev. On Railway, set these as service variables.

# Public URL of the site (no trailing slash). Used in emails and the origin check.
PUBLIC_URL=http://localhost:3000
# Optional: redirect every other hostname to this one (e.g. quickfix.example.com).
CANONICAL_HOST=

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-REF.supabase.co
SUPABASE_ANON_KEY=
# Secret. Server only. Never put this in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic console → API keys. Set a monthly spend limit on the key's workspace.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# Cost guards (rolling 24 hours)
DAILY_AI_LIMIT_PER_USER=8
DAILY_AI_LIMIT_GLOBAL=400

# Resend → API keys. Day 7 reminders are skipped when unset.
RESEND_API_KEY=
EMAIL_FROM=Klinik Bisnes SME <quickfix@your-domain.com>

# Bump when the privacy notice changes; participants are asked to accept again.
NOTICE_VERSION=2026-10-v1
