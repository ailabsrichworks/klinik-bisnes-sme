# Copy to .env for local dev. On Railway, set these as service variables.

# Public URL of the site (no trailing slash). Used in the API origin check.
PUBLIC_URL=http://localhost:3000
# Optional: redirect every other hostname to this one (production: klinik.richworks.com).
CANONICAL_HOST=

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-REF.supabase.co
SUPABASE_ANON_KEY=
# Secret. Server only. Never put this in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic console → API keys. Set a monthly spend limit on the key's workspace.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Sonnet 5.5 defaults to high when unset; medium keeps cost and latency down.
CLAUDE_EFFORT=medium

# Cost guards (rolling 24 hours). Anonymous participants are free to create, so keep the per-user cap low.
DAILY_AI_LIMIT_PER_USER=3
DAILY_AI_LIMIT_GLOBAL=400

# Optional Cloudflare Turnstile on sign-in (participants' anonymous join and trainer login).
# Put the SECRET key in Supabase → Authentication → Attack Protection → captcha (Turnstile); the site key here.
# Leave empty to run without captcha.
TURNSTILE_SITE_KEY=

# Bump when the privacy notice changes; participants are asked to accept again.
NOTICE_VERSION=2026-10-v2
